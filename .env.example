# FreeTV configuration. Copy to .env and edit. Every variable is optional except PROXY_SECRET.
# Reference: docs/ARCHITECTURE.md ("Environment variables").

# ---- Edge (web / Caddy) -------------------------------------------------
# Your public domain, e.g. tv.example.com. Leave empty to serve plain HTTP on port 80.
# With a domain set, Caddy obtains a Let's Encrypt certificate automatically.
# DNS must point at this host and ports 80 and 443 must be reachable.
DOMAIN=
# Public base URL (with scheme) used in M3U exports and casting. Usually https://$DOMAIN.
PUBLIC_URL=

# ---- Compose profiles ---------------------------------------------------
# epg   = TV guide grabber (iptv-org/epg).
# proxy = HLS relay for streams that fail on CORS/mixed content. OFF by default ("hub mode"): the
#         site never carries video, viewers' devices fetch streams directly, and channels that can't
#         play in a browser offer "Open in app" instead. To enable: COMPOSE_PROFILES=proxy,epg and
#         PROXY_ENABLED=true, and read docs/OPERATIONS.md "Relay" about bandwidth first.
COMPOSE_PROFILES=epg

# ---- Images -------------------------------------------------------------
# Owner of the published images, ghcr.io/<owner>/freetv-<svc>. Lowercase, and your own GitHub
# user or org (the one whose CI pushed the images). Leave EMPTY to build everything on this host:
# update.sh then never pulls, and compose uses the namespace "local", which nothing publishes to.
# Never leave another project's owner here: update.sh pulls from this namespace.
GITHUB_REPOSITORY_OWNER=
# Image tag: latest, a git tag such as v1.2.0, or sha-<short>. Only used when pulling.
FREETV_TAG=latest
# iptv-org/epg commit the grabber image is built from (build-time only). Pinned to a tested commit.
# To bump: choose a newer commit on iptv-org/epg, set it here (and in apps/epg/Dockerfile and
# docker-compose.yml, which default to the same value), then run `docker compose up -d --build epg`.
# A branch or tag name also works, but then the build is not reproducible.
EPG_REF=8c23cfe7396724ee5297f370415fc04d6fda058c
# Container log level for api and proxy (passed as LOG_LEVEL). warn keeps logs quiet; use info to
# see one line per request, or silent to stop logging. Docker also rotates logs at 20 MB x 5.
LOG_LEVEL=warn

# ---- API / catalog (api) -------------------------------------------------
# Dataset base URL. Fallback mirror: https://raw.githubusercontent.com/iptv-org/api/gh-pages
IPTV_API_BASE=https://iptv-org.github.io/api
# How often the catalog is re-downloaded and rebuilt.
INGEST_INTERVAL_HOURS=6
# Hide NSFW and blocklisted channels unless a request asks for nsfw=true.
HIDE_NSFW_DEFAULT=true
# Whether the API issues relay URLs. false = hub mode (default). Must match the proxy profile above.
PROXY_ENABLED=false
# Admin token for POST /api/admin/* (Authorization: Bearer <token>). Empty disables admin endpoints.
ADMIN_TOKEN=
# How often the api checks the guide file for changes, in seconds.
# EPG_POLL_SECONDS=60
# Version string reported by /api/meta.
# APP_VERSION=0.1.0

# ---- Proxy (api + proxy) -------------------------------------------------
# REQUIRED. Shared HMAC key between api and proxy. Generate with:
#   infra/scripts/gen-secret.sh --write
# Must be the same value for api and proxy (compose passes it to both).
# Rotating it invalidates every signed relay URL, including exported playlists.
PROXY_SECRET=change-me-run-openssl-rand-hex-32
# Public path prefix the browser uses to reach the relay. Caddy routes /proxy/* to the proxy,
# so change this only together with infra/caddy/Caddyfile.
PROXY_PUBLIC_PATH=/proxy
# Upstream connection cap for the relay.
PROXY_MAX_CONCURRENT=200
# Per-request byte budget for relayed responses (default 50 MiB).
PROXY_MAX_BYTES=52428800
# Lifetime of a signed relay URL in seconds, as handed out on channel pages (api). Default 86400 (24 h).
# Empty or unset uses the api's default.
# PROXY_URL_TTL_SECONDS=86400
# Lifetime in seconds of URLs inside exported M3U playlists (api). Default 604800 (7 days).
# PROXY_EXPORT_TTL_SECONDS=604800

# ---- TV guide (epg) ------------------------------------------------------
# "all" or a comma list of iptv-org/epg site names, e.g. tvguide.com,bbc.co.uk.
# RECOMMENDED for small VMs (under 6 GB RAM): set a curated list here, e.g.
#   EPG_SITES=tvguide.com,freeview.co.uk
# "all" grabs about 190 guide sites (~25k requests per run) and takes hours of CPU. The default stays "all"
# so the full guide works out of the box on a large host.
# Memory caps (Docker cgroup limits). On a 12 GB VM, 4g/1g is right; on 24 GB you can give the
# grabber 8g — set EPG_NODE_OPTIONS=--max-old-space-size=6144 to match.
# EPG_MEM_LIMIT=4g
# EPG_NODE_OPTIONS=--max-old-space-size=3072
# API_MEM_LIMIT=1g
EPG_SITES=all
# Comma list of sites to drop after EPG_SITES is applied.
# EPG_EXCLUDE_SITES=
# Keep one guide site per channel (true, recommended), or grab every mapping (false: more requests, overlapping data).
# EPG_ONE_SITE_PER_CHANNEL=true
# Days of schedule to grab.
EPG_DAYS=2
# Grabber concurrency.
EPG_MAX_CONNECTIONS=10
# Per-request timeout for the grabber, in milliseconds.
# EPG_TIMEOUT_MS=30000
# Extra arguments for the grabber command, whitespace separated (no quoting).
# EPG_GRAB_ARGS=
# RECOMMENDED: true. Grabs one site at a time and keeps the guide from the sites that worked, so one slow
# site cannot stall or kill the whole run and peak memory stays lower. The default is false for compatibility.
EPG_SPLIT_BY_SITE=false
# Time between grabs.
EPG_INTERVAL_HOURS=12
# Grab immediately when the container starts.
EPG_RUN_ON_START=true

# ---- Stream health prober (api) ------------------------------------------
# Defaults shown. Uncomment to change. Probes read only the first few KB of each playlist.
# Set false to turn the prober off.
# PROBE_ENABLED=true
# Time to cycle through every stream once.
# PROBE_INTERVAL_HOURS=6
# Parallel probes.
# PROBE_CONCURRENCY=8
# Global probe rate cap (be polite to stream hosts).
# PROBE_RATE_PER_SECOND=5
# Per-probe timeout in milliseconds.
# PROBE_TIMEOUT_MS=10000

# ---- Logo cache (api) ----------------------------------------------------
# Serve channel logos from /logo/:id through a disk cache.
# LOGO_CACHE_ENABLED=true
# Cache directory inside the data volume.
# LOGO_CACHE_DIR=/data/logos
# LRU eviction threshold in MiB.
# LOGO_CACHE_MAX_MB=500
# Largest edge (px) served.
# LOGO_MAX_SIZE=512

# ---- Operator blocklist (api) --------------------------------------------
# JSON array of channel ids to hide on top of iptv-org's blocklist. Managed with
# infra/scripts/block-channel.sh <id>. The file lives in the data volume.
# LOCAL_BLOCKLIST=/data/local-blocklist.json

# ---- Relay limits (proxy) ------------------------------------------------
# Per-client-IP sustained requests per second. A viewer fetches a segment every 2-6 s,
# so 20 leaves room for several tabs behind one NAT.
# PROXY_RATE_LIMIT_RPS=20
# Burst allowance above the sustained rate.
# PROXY_RATE_LIMIT_BURST=60
# Concurrent upstream connections per client IP. Requests beyond this are rejected. 0 disables the cap.
# PROXY_MAX_CONCURRENT_PER_IP=16
# Read the client IP from X-Forwarded-For (set by Caddy). Keep true unless the proxy port is exposed.
# PROXY_TRUST_PROXY=true
# Dev only: lets the relay reach loopback and private addresses. Never set this on an internet-facing instance.
# PROXY_ALLOW_PRIVATE=false

# ---- Monitoring profile (prometheus, grafana) ----------------------------
# Set this before enabling the monitoring profile (update.sh refuses the placeholder). Grafana listens on 127.0.0.1:3002 only.
# GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Prometheus data retention.
# PROMETHEUS_RETENTION=30d

# ---- Auto-updates (watchtower profile) -----------------------------------
# Only used when COMPOSE_PROFILES includes "autoupdate". 6-field cron, seconds first.
# WATCHTOWER_SCHEDULE=0 0 4 * * *
