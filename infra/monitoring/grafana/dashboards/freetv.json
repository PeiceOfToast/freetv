    {
      "id": 16,
      "type": "timeseries",
      "title": "Relay request latency p95",
      "description": "95th percentile time from request receipt to response end, including streaming. Segment fetches are short; playlists are shorter still.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(freetv_proxy_request_duration_seconds_bucket[5m])))",
