    {
      "id": 13,
      "type": "timeseries",
      "title": "Rate-limited requests",
      "description": "Requests rejected by PROXY_RATE_LIMIT_RPS/BURST or PROXY_MAX_CONCURRENT_PER_IP. A few is normal; a sustained rate means one client or NAT is over budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
