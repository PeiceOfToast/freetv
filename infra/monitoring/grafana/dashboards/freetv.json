    {
      "id": 14,
      "type": "timeseries",
      "title": "Relay in-flight requests",
      "description": "Requests holding an upstream slot. Approaching PROXY_MAX_CONCURRENT (200) means the relay is saturated.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
