# FreeTV edge: serves the SPA and reverse-proxies the API and the HLS relay.
#
# Bind-mounted into the `web` container at /etc/caddy by docker-compose.yml, so edits
# take effect on `docker compose restart web`. apps/web/Caddyfile is the copy baked into
# the image; CI fails if the two drift apart.
#
# SITE_ADDRESS is computed in docker-compose.yml: DOMAIN when set (automatic HTTPS),
# otherwise ":80" (plain HTTP). The default below only matters for standalone runs.

{$SITE_ADDRESS::80} {
	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)"
		# Deliberately narrow: only framing, media and connections are restricted. Stream
		# URLs point at arbitrary hosts and hls.js plays through blob: MediaSource URLs, so
		# media-src and connect-src must stay open. No script-src: the SPA has no inline scripts,
		# but a strict script policy would be fragile across hls.js worker blobs.
		Content-Security-Policy "frame-ancestors 'self'; media-src * blob:; connect-src *"
		-Server
	}

	# JSON API. Compressed; no prefix stripping (api serves /api/* itself).
	handle /api/* {
		encode zstd gzip
		reverse_proxy api:3000
	}

	# HLS relay. Passes the path through unchanged (proxy serves /proxy/*).
	# Not compressed (media) and flushed immediately so live segments are not held back.
	# If the proxy profile is disabled, Caddy answers 502 because `proxy` does not resolve;
	# the UI treats any failure on /proxy as "proxy unavailable".
	handle /proxy/* {
		reverse_proxy proxy:3001 {
			flush_interval -1
		}
	}

	# Hashed build output: cache forever. Missing files 404 instead of falling back to index.html.
	handle /assets/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: static files, then the SPA fallback. index.html and deep links must
	# never be cached so a redeploy is picked up immediately.
	handle {
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
